      ],
      "id": "CU-02",
      "nombre": "Iniciar combate",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El jugador solicita el inicio del combate entre los dos personajes seleccionados.",
      "incluye": [
        "CU-01"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-03"
      ],
      "id": "CU-03",
      "nombre": "Validar participantes",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema verifica que ambos personajes tengan puntos de vida superiores a cero antes de iniciar el combate.",
      "incluye": [
        "CU-02"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-04"
      ],
      "id": "CU-04",
      "nombre": "Establecer turno inicial",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema asigna el primer turno al personaje que inició el enfrentamiento.",
      "incluye": [
        "CU-03"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-05"
      ],
      "id": "CU-05",
      "nombre": "Gestionar turnos",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema alternará los turnos entre los dos personajes después de cada acción válida, mientras el combate continúe.",
      "incluye": [
        "CU-04"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-06"
      ],
      "id": "CU-06",
      "nombre": "Seleccionar acción",
      "actores": [
        "Jugador"
      ],
      "descripcion": "Durante su turno, el participante podrá seleccionar una de las acciones disponibles: ataque o defensa (esquiva).",
      "incluye": [
        "CU-05"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-07"
      ],
      "id": "CU-07",
      "nombre": "Ejecutar ataque",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema ejecutará el ataque del personaje que tenga el turno correspondiente contra su oponente.",
      "incluye": [
        "CU-06"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-08"
      ],
      "id": "CU-08",
      "nombre": "Ejecutar defensa",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema permitirá activar una acción defensiva para esquivar el siguiente ataque del oponente durante el siguiente turno de este.",
      "incluye": [
        "CU-06"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-09"
      ],
      "id": "CU-09",
      "nombre": "Calcular daño",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema calculará el daño de un ataque usando el atributo de ataque del personaje atacante y respetando un daño mínimo de 1 punto.",
      "incluye": [
        "CU-07"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-10"
      ],
      "id": "CU-10",
      "nombre": "Aplicar daño",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema descontará los puntos de daño de la vida del personaje afectado, excepto cuando el ataque haya sido esquivado.",
      "incluye": [
        "CU-09"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-11"
      ],
      "id": "CU-11",
      "nombre": "Actualizar puntos de vida",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema actualizará los puntos de vida del personaje afectado y reflejará el nuevo valor.",
      "incluye": [
        "CU-10"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-12"
      ],
      "id": "CU-12",
      "nombre": "Verificar estado del combate",
      "actores": [
        "Jugador"
      ],
      "descripcion": "Después de cada acción, el sistema comprobará si alguno de los personajes ha llegado a 0 puntos de vida.",
      "incluye": [
        "CU-11"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-13"
      ],
      "id": "CU-13",
      "nombre": "Finalizar combate",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema finalizará inmediatamente el combate cuando uno de los personajes llegue a 0 puntos de vida.",
      "incluye": [
        "CU-12"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-14"
      ],
      "id": "CU-14",
      "nombre": "Determinar ganador",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema identificará como ganador al personaje que conserve puntos de vida superiores a 0 cuando su oponente llegue a 0.",
      "incluye": [
        "CU-13"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-15"
      ],
      "id": "CU-15",
      "nombre": "Registrar resultado",
      "actores": [
        "Jugador"
      ],
      "descripcion": "El sistema almacenará un único resultado por combate finalizado, incluyendo el combate, sus participantes y el ganador.",
      "incluye": [
        "CU-14"
      ],
      "extiende": []
    },
    {
      "req_ids": [
        "RF-16"
      ],
      "id": "CU-16",
      "nombre": "Mostrar resultado",
      "actores": [
